node_modules/
dist/
.env
.env.*
!.env.example
.phira-local-chart-manager.pid
.phira-pmp-plus.pid

certs/*.crt
certs/*.key
logs/*.log
logs/*.pid
data/private-records/token-capture*.jsonl
