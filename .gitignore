# Private or potentially copyrighted chart assets. Deploy these separately.
charts/*.zip
data/private-charts/*
data/instances/*
data/instances-test-default/
data/test-instances/

# Runtime accounts, scores, captures, test data and generated screenshots.
data/
artifacts/

# Compiled from the MIT-licensed phira-web-monitor sources by `npm run build:renderer`.
# The WASM renderer, the chart-compiler binary and any third-party resource pack are
# build outputs, and the pack is artwork with no redistribution grant.
vendor/

# The customized PMP+ source lives in its own repository. Only local runtime
# binaries, configuration, plugins and data are kept here, and none are committed.
pmp-runtime/
# Ignore any legacy local checkout/config left from versions that vendored PMP+.
mp-server/

# Local deployment handoff notes may contain machine-specific operational details.
DESIGN.md
docs/handoff*.md
docs/monitor-plan*.md

*.sqlite
*.sqlite-*
*.db
*.db-*
*.jsonl

# Local verification material and private chart packages must never be published.
decoder/*.bin
*.zip
*.pez
*.pem
*.pfx
*.p12

!certs/.gitkeep
!logs/.gitkeep
