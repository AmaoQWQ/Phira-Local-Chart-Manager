# 本 crate 不是独立项目：它必须作为 phira-web-monitor 工作区的成员构建，
# 因为 src/main.rs 用 #[path] 复用该仓库的 monitor-proxy/src/utils/parse.rs，
# 并依赖同工作区的 monitor-common。
#
# 因此下面的路径依赖（../monitor-common）是相对于"被复制进克隆目录之后"的位置。
# 构建请用仓库根目录的 node scripts/build-renderer.js：它会自动克隆/更新
# phira-web-monitor → 复制本目录进其工作区 → 注册 workspace 成员 →
# 构建 wasm 渲染器与 chart-compiler → 把产物拷回本仓库的 vendor/renderer/。

[package]
name = "chart-compiler"
version = "0.1.0"
edition = "2021"

[[bin]]
name = "chart-compiler"
path = "src/main.rs"

[dependencies]
monitor-common = { path = "../monitor-common" }
anyhow = "1.0"
log = "0.4"
env_logger = "0.10"
byteorder = "1.5"
ordered-float = "3.4"
image = "0.25.9"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
serde_yaml = "0.9"
bincode = "1.3"
# 只要 deflate：默认 feature 会拉入 aes/pbkdf2/hmac/zstd/deflate64/ppmd，
# 其中 aes 0.9 要求 rustc ≥1.89，而本机是 1.88；PEZ 也不使用这些算法。
zip = { version = "8.1", default-features = false, features = ["deflate"] }
tempfile = "3"
tokio = { version = "1", features = ["rt-multi-thread", "macros", "fs"] }

# 刻意声明为空工作区：让本 crate 脱离 phira-web-monitor 的工作区独立构建。
# 否则从工作区根构建会把 monitor-proxy 一起选入，其 phira-mp-common 启用了
# `stream` feature —— 该 feature 使用 std::os::unix::ffi::OsStrExt，
# 在 Windows 上无法编译。独立构建后只按本 crate 的依赖图解析 features。
[workspace]
