# Internal HTTPS listener. Stock Phira still connects to external TCP 443;
# DNS override cannot translate 443 to this port. A router port mapping or
# reverse proxy may expose 443 and forward to an internal PORT such as 8443.
HOST=0.0.0.0
PORT=443
# Loopback management port. Account-based /admin is also served by the HTTPS Gateway.
ADMIN_PORT=9000

# The legacy in-process Phira-MP v1 server is retained only for protocol tests.
# Production multiplayer is provided by the separate AmaoQWQ/Phira-mp-plus fork.
MULTIPLAYER_ENABLED=false
MULTIPLAYER_HOST=0.0.0.0
MULTIPLAYER_PORT=12348

# PMP+ room-state feed used by the read-only admin room monitor.
PMP_MONITOR_ENABLED=false
PMP_BASE_URL=http://127.0.0.1:12357
PMP_ROOMS_SNAPSHOT_PATH=/api/rooms/info
PMP_EVENTS_PATH=/api/rooms/listen
PMP_MONITOR_TOKEN=
# PMP+ 原生房间管理令牌。留空时网关使用下方 ADMIN_TOKEN；不要提交真实令牌。
PMP_ADMIN_TOKEN=
# PMP+ 稳定节点身份密钥。请替换为另一个独立的长随机值。
HSN_SECRET_KEY=replace-with-another-long-random-secret

# Official server-side origin used for requests this Gateway does not handle.
# The server itself must resolve this hostname to the real official service,
# not back to this Gateway, or forwarding will loop.
UPSTREAM_BASE_URL=https://phira.5wyxi.com
# Optional external HTTPS origin embedded in private chart resource URLs.
# Leave empty to derive it from the incoming Host. For stock Phira deployment,
# set https://phira.5wyxi.com; never use localhost for phones or other devices.
PUBLIC_BASE_URL=
# Optional dedicated hostname that serves the browser homepage. Leave empty to disable it.
HOMEPAGE_HOST=
# Optional deployment-specific player guide. Keep real domains/IPs in an ignored local file.
USER_GUIDE_PATH=USER.md

# Local private chart resources.
PRIVATE_CHARTS_PATH=data/private-charts
# Add the private test chart to eligible /chart list responses.
PRIVATE_CHART_LISTING=true
# Persistent local private score database.
PRIVATE_RECORDS_PATH=data/private-records/records.json
# SQLite database used by the Gateway. The JSON file is retained as a migration backup.
PRIVATE_RECORDS_DB_PATH=data/private-records/records.sqlite
# Verification key used to decode v0.8.2 record-v3 tokens for registered private charts.
PRIVATE_RECORD_VERIFICATION_KEY_PATH=decoder/record-verification-key.bin
# Optional decoder adapter. The gateway can start without this plugin or the key.
PRIVATE_RECORD_DECODER_PLUGIN=decoder/decoder-dist/private-upload-adapter.js
# Leave empty/undefined during normal operation. When set, private upload tokens are
# written locally for format analysis; never expose or commit this file.
PRIVATE_TOKEN_CAPTURE_PATH=

# Required to initialize the super administrator; legacy API use is loopback-only.
# Use a long random value and do not commit .env.
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Admin chart preview. The renderer is built locally with `npm run build:renderer`,
# which needs a Rust toolchain and wasm-pack; nothing under vendor/ is committed.
MONITOR_RENDERER_PATH=vendor/renderer
# Compiled payloads embed decoded audio (tens of MB each), so they are cached here.
MONITOR_CACHE_PATH=data/monitor-cache
# Oldest cached payloads are dropped beyond this size. 0 disables the limit.
MONITOR_CACHE_MAX_MB=2048

# If omitted, the server uses certs/server.crt and certs/server.key. The
# generated certificate is self-signed and covers phira.5wyxi.com + localhost;
# it is intended only for local testing or Phira's explicitly enabled unsafe mode.
TLS_CERT_PATH=certs/server.crt
TLS_KEY_PATH=certs/server.key

LOG_TO_FILE=false
LOG_FILE_PATH=logs/requests.log

# Only enable for short, local debugging. The preview is capped at 4 KiB.
DEBUG_BODY=false
DEBUG_BODY_MAX_BYTES=4096
