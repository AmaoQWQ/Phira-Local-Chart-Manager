# The default is 0.0.0.0:443. Use PORT=8443 for an unprivileged local test.
HOST=0.0.0.0
PORT=443
# Loopback management port. Account-based /admin is also served by the HTTPS Gateway.
ADMIN_PORT=9000

# Phira-MP v1 TCP room service. The iPad multiplayer server uses this host/port.
MULTIPLAYER_ENABLED=true
MULTIPLAYER_HOST=0.0.0.0
MULTIPLAYER_PORT=12348

# The server-side origin used for API forwarding. Do not point this back to the local override.
UPSTREAM_BASE_URL=https://phira.5wyxi.com

# Local private chart resources.
PRIVATE_CHARTS_PATH=data/private-charts
# Add the private test chart to eligible /chart list responses.
PRIVATE_CHART_LISTING=true
# Persistent local private score database.
PRIVATE_RECORDS_PATH=data/private-records/records.json
# SQLite database used by the Gateway. The JSON file is retained as a migration backup.
PRIVATE_RECORDS_DB_PATH=data/private-records/records.sqlite
# Verification key used to decode v0.8.2 record-v3 tokens for registered private charts.
PRIVATE_RECORD_VERIFICATION_KEY_PATH=decoder/record-verification-key.bin
# Leave empty/undefined during normal operation. When set, private upload tokens are
# written locally for format analysis; never expose or commit this file.
PRIVATE_TOKEN_CAPTURE_PATH=

# Required to initialize the super administrator; legacy API use is loopback-only.
# Use a long random value and do not commit .env.
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# If omitted, the server uses certs/server.crt and certs/server.key.
TLS_CERT_PATH=certs/server.crt
TLS_KEY_PATH=certs/server.key

LOG_TO_FILE=false
LOG_FILE_PATH=logs/requests.log

# Only enable for short, local debugging. The preview is capped at 4 KiB.
DEBUG_BODY=false
DEBUG_BODY_MAX_BYTES=4096
